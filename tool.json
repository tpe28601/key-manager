{
  "$schema": "../Dev-Toolbox/spec/tool.schema.json",
  "specVersion": 1,
  "kind": "tool",
  "id": "key-manager",
  "name": "Key Manager",
  "version": "1.1.1",
  "description": "SSH / GPG 金鑰與 Git 簽章設定管理（pywebview 桌面版 + Dev-Toolbox Web 版）",
  "runtime": { "kind": "python", "min": "3.11" },
  "web": { "entry": "web_server.py", "defaultPort": 8730, "health": "/api/health" },
  "cli": { "entry": "web_server.py", "menu": false, "json": false },
  "requires": ["git"],
  "dataDir": "%LOCALAPPDATA%/DevToolbox/key-manager",
  "uiKitTarget": "src/key_manager/web/static",
  "uiKit": "3.0.0"
}
